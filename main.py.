            padx=2,
            pady=2,
        )
        if col_span > 1:
          c_offset += 1

  def app(self, val):
    self.expression += str(val)
    self.expr_lbl.config(text=self.expression)

  def clear_all(self):
    self.expression = ""
    self.expr_lbl.config(text="")
    self.res_lbl.config(text="0")

  def del_last(self):
    self.expression = self.expression[:-1]
    self.expr_lbl.config(text=self.expression)

  def mem_op(self, op):
    try:
      curr = float(self.res_lbl.cget("text"))
      if op == "MC":
        self.memory = 0.0
      elif op == "MR":
        self.app(str(self.memory))
      elif op == "M+":
        self.memory += curr
      elif op == "M-":
        self.memory -= curr
    except Exception:
      pass

  def eval_expr(self):
    try:
      expr = self.expression.replace("π", "math.pi").replace("e", "math.e")
      safe_dict = {
          "math": math,
          "sin": lambda x: math.sin(math.radians(x)),
          "cos": lambda x: math.cos(math.radians(x)),
          "tan": lambda x: math.tan(math.radians(x)),
          "asin": lambda x: math.degrees(math.asin(x)),
          "acos": lambda x: math.degrees(math.acos(x)),
          "atan": lambda x: math.degrees(math.atan(x)),
          "sinh": math.sinh,
          "cosh": math.cosh,
          "tanh": math.tanh,
          "sqrt": math.sqrt,
          "cbrt": lambda x: x ** (1 / 3),
          "log10": math.log10,
          "log": math.log,
          "exp": math.exp,
          "fact": math.factorial,
          "abs": abs,
          "pi": math.pi,
          "e": math.e,
      }
      res = eval(expr, {"__builtins__": None}, safe_dict)
      out = f"{res:.8g}" if isinstance(res, float) else str(res)
      self.res_lbl.config(text=out)
    except Exception:
      self.res_lbl.config(text="خطأ رياضي")

